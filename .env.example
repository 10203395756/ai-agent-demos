# ============== 运行模式 ==============
# mock=离线演示模式（无需API Key，直接跑通）
# real=真实API模式（需配置下方Key）
RUN_MODE=mock

# ============== LLM配置（RUN_MODE=real时生效） ==============
# 支持：openai / qianfan（文心一言）/ dashscope（通义千问）/ deepseek
LLM_PROVIDER=qianfan
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
QIANFAN_AK=
QIANFAN_SK=
QIANFAN_MODEL=ernie-4.0-turbo-8k
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Embedding模型
EMBEDDING_PROVIDER=local  # local=本地bge-small-zh / openai / qianfan
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ============== 服务配置 ==============
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# ============== 工程化配置 ==============
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
ENABLE_METRICS=true
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# ============== 向量数据库 ==============
VECTOR_STORE=chroma  # chroma / faiss / milvus
VECTOR_PERSIST_DIR=./data/vector_db
